msgstr "参观了艺术博物馆"

#. MoreRoomTypes.STRINGS.ROOMS.EFFECTS.MUSEUMSPACE.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.EFFECTS.MUSEUMSPACE.NAME"
msgid "Space Museum"
msgstr "太空博物馆"

#. MoreRoomTypes.STRINGS.ROOMS.EFFECTS.MUSEUMSPACE.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.EFFECTS.MUSEUMSPACE.DESCRIPTION"
msgid "Visited Space Museum"
msgstr "参观了太空博物馆"

#. MoreRoomTypes.STRINGS.ROOMS.EFFECTS.GRAVE_GOOD.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.EFFECTS.GRAVE_GOOD.NAME"
msgid "Graveyard Serenity"
msgstr "墓地安宁"

#. MoreRoomTypes.STRINGS.ROOMS.EFFECTS.GRAVE_GOOD.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.EFFECTS.GRAVE_GOOD.DESCRIPTION"
msgid "This Duplicant has accepted their inevitable fate and is ready to embrace it."
msgstr "这名复制人已经接受不可避免的命运，并准备好面对它。"

#. MoreRoomTypes.STRINGS.ROOMS.EFFECTS.GRAVE_BAD.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.EFFECTS.GRAVE_BAD.NAME"
msgid "Graveyard Dread"
msgstr "墓地恐惧"

#. MoreRoomTypes.STRINGS.ROOMS.EFFECTS.GRAVE_BAD.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.EFFECTS.GRAVE_BAD.DESCRIPTION"
msgid "This Duplicant feels cold claws of Death crawling up their spine."
msgstr "这名复制人感到死神冰冷的爪子爬上了脊背。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.PRIVATEBATHROOM.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.PRIVATEBATHROOM.NAME"
msgid "Private Bathroom"
msgstr "私人卫生间"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.PRIVATEBATHROOM.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.PRIVATEBATHROOM.DESCRIPTION"
msgid "Finally, a place to truly be alone with one's thoughts.\n\nUsing a Private Bathroom will greatly improve Duplicants' Morale.\nShowers in this room finish faster."
msgstr "终于，一个真正能让人单独思考的地方。\n\n使用私人卫生间会大大提升复制人的士气。\n在此淋浴会更快完成。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.PRIVATEBATHROOM.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.PRIVATEBATHROOM.EFFECT"
msgid "- Morale bonus"
msgstr "- 士气加成"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.PRIVATEBATHROOM.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.PRIVATEBATHROOM.TOOLTIP"
msgid "Using a Private Bathroom will greatly improve Duplicants' Morale"
msgstr "使用私人卫生间会大大提升复制人的士气"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WAREHOUSE.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WAREHOUSE.NAME"
msgid "Warehouse"
msgstr "仓库"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WAREHOUSE.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WAREHOUSE.DESCRIPTION"
msgid "An enclosed space for keeping supplies in order.\n\nA Warehouse does not change storage capacity."
msgstr "一个用来整理物资的封闭空间。\n\n仓库不会改变储存容量。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WAREHOUSE.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WAREHOUSE.EFFECT"
msgid "- No effect"
msgstr "- 无效果"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WAREHOUSE.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WAREHOUSE.TOOLTIP"
msgid "A Warehouse does not change storage capacity"
msgstr "仓库不会改变储存容量"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.BATTERYROOM.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.BATTERYROOM.NAME"
msgid "Battery Room"
msgstr "储能室"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.BATTERYROOM.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.BATTERYROOM.DESCRIPTION"
msgid "A dedicated space for stored power.\n\nBatteries in a Battery Room lose charge more slowly."
msgstr "专门存放电力的空间。\n\n储能室中的电池漏电更慢。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.BATTERYROOM.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.BATTERYROOM.EFFECT"
msgid "- Reduced battery leakage"
msgstr "- 降低电池漏电"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.BATTERYROOM.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.BATTERYROOM.TOOLTIP"
msgid "Batteries in a Battery Room lose charge more slowly"
msgstr "储能室中的电池漏电更慢"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WASTEROOM.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WASTEROOM.NAME"
msgid "Waste Processing Room"
msgstr "废料处理间"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WASTEROOM.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WASTEROOM.DESCRIPTION"
msgid "Where refuse is put back to work.\n\nCompost, Sludge Presses and Fertilizer Synthesizers in a Waste Processing Room function more efficiently."
msgstr "废物在这里重新发挥作用。\n\n废料处理间中的堆肥堆、泥浆压榨器和肥料合成器使用效率更高。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WASTEROOM.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WASTEROOM.EFFECT"
msgid "- Efficiency bonus"
msgstr "- 效率加成"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WASTEROOM.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WASTEROOM.TOOLTIP"
msgid "Compost, Sludge Presses and Fertilizer Synthesizers in a Waste Processing Room function more efficiently"
msgstr "废料处理间中的堆肥堆、泥浆压榨器和肥料合成器使用效率更高"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WATERROOM.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WATERROOM.NAME"
msgid "Water Treatment Room"
msgstr "水处理间"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WATERROOM.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WATERROOM.DESCRIPTION"
msgid "Where dirty water gets a second chance.\n\nWater Sieves and Desalinators in a Water Treatment Room function more efficiently."
msgstr "脏水在这里获得第二次机会。\n\n水处理间中的净水器和脱盐器使用效率更高。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WATERROOM.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WATERROOM.EFFECT"
msgid "- Efficiency bonus"
msgstr "- 效率加成"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.WATERROOM.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.WATERROOM.TOOLTIP"
msgid "Water Sieves and Desalinators in a Water Treatment Room function more efficiently"
msgstr "水处理间中的净水器和脱盐器使用效率更高"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.HALLWAY.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.HALLWAY.NAME"
msgid "Hallway"
msgstr "走廊"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.HALLWAY.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.HALLWAY.DESCRIPTION"
msgid "A transit shaft for moving between floors.\n\nDuplicants in a Hallway gain Athletics."
msgstr "用于楼层之间通行的竖井。\n\n身处走廊会提升复制人的运动。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.HALLWAY.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.HALLWAY.EFFECT"
msgid "- Athletics bonus"
msgstr "- 运动加成"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.HALLWAY.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.HALLWAY.TOOLTIP"
msgid "Duplicants in a Hallway gain Athletics"
msgstr "身处走廊会提升复制人的运动"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.NUCLEARPLANT.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.NUCLEARPLANT.NAME"
msgid "Nuclear Power Plant"
msgstr "核电站"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.NUCLEARPLANT.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.NUCLEARPLANT.DESCRIPTION"
msgid "The perfect place for Duplicants to flex their Electrical Engineering skills.\n\nHeavy-duty generators built within a Nuclear Power Plant can be tuned up using microchips from power control stations to improve their <link=\"POWER\">Power</link> production."
msgstr "复制人施展电气工程技能的理想场所。\n\n建在核电站中的重型发电机可以用电控站的微芯片进行调校来提高<link=\"POWER\">电力</link>生产。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.NUCLEARPLANT.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.NUCLEARPLANT.EFFECT"
msgid "- Enables <link=\"POWERSTATIONTOOLS\">Microchip</link> tune-ups on heavy-duty generators"
msgstr "- 能够用<link=\"POWERSTATIONTOOLS\">微芯片</link>对重型发电机进行调校"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.NUCLEARPLANT.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.NUCLEARPLANT.TOOLTIP"
msgid "Heavy-duty generators built in a Nuclear Power Plant can be tuned up using microchips from Power Control Stations to improve their Power production"
msgstr "建在核电站中的重型发电机可以用电控站的微芯片进行调校来提高电力生产"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.FLUSHTOILET_ONE.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.FLUSHTOILET_ONE.NAME"
msgid "Exactly one Flush Toilet"
msgstr "恰好 1 个抽水马桶"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.FLUSHTOILET_ONE.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.FLUSHTOILET_ONE.DESCRIPTION"
msgid "The room must contain exactly one Flush Toilet."
msgstr "房间内必须恰好有 1 个抽水马桶。"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.SINK_ONE.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.SINK_ONE.NAME"
msgid "Exactly one Sink"
msgstr "恰好 1 个洗手池"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.SINK_ONE.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.SINK_ONE.DESCRIPTION"
msgid "The room must contain exactly one Sink."
msgstr "房间内必须恰好有 1 个洗手池。"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.SHOWER_ONE.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.SHOWER_ONE.NAME"
msgid "Exactly one Shower"
msgstr "恰好 1 个淋浴间"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.SHOWER_ONE.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.SHOWER_ONE.DESCRIPTION"
msgid "The room must contain exactly one Shower."
msgstr "房间内必须恰好有 1 个淋浴间。"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.STORAGE_BUILDINGS.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.STORAGE_BUILDINGS.NAME"
msgid "4 Storage Buildings"
msgstr "4 个储物建筑"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.STORAGE_BUILDINGS.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.STORAGE_BUILDINGS.DESCRIPTION"
msgid "At least 4 storage buildings."
msgstr "至少 4 个储物建筑。"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.BATTERIES.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.BATTERIES.NAME"
msgid "4 Batteries"
msgstr "4 个电池"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.BATTERIES.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.BATTERIES.DESCRIPTION"
msgid "At least 4 batteries. Rocket battery modules count."
msgstr "至少 4 个电池。火箭电池仓也算。"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.NO_EXTRA_INDUSTRIAL.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.NO_EXTRA_INDUSTRIAL.NAME"
msgid "No extra industrial machinery"
msgstr "无额外工业设备"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.NO_EXTRA_INDUSTRIAL.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.NO_EXTRA_INDUSTRIAL.DESCRIPTION"
msgid "No industrial machinery except batteries, rocket battery modules, and power transformers."
msgstr "不能有蓄电池、电池仓、电力调节器（大小变压器）以外的工业设备。"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.COMPOST.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.COMPOST.NAME"
msgid "Compost"
msgstr "堆肥堆"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.COMPOST.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.COMPOST.DESCRIPTION"
msgid "At least one Compost."
msgstr "至少一个堆肥堆。"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.WASTE_PROCESSOR.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.WASTE_PROCESSOR.NAME"
msgid "Waste Processor"
msgstr "废料处理设备"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.WASTE_PROCESSOR.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.WASTE_PROCESSOR.DESCRIPTION"
msgid "A Sludge Press or Fertilizer Synthesizer."
msgstr "泥浆压榨器或肥料合成器。"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.WATER_TREATMENT.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.WATER_TREATMENT.NAME"
msgid "Water Treatment"
