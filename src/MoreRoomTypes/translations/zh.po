#. MoreRoomTypes.STRINGS.TRANSLATION.AUTHOR.NAME
msgctxt "MoreRoomTypes.STRINGS.TRANSLATION.AUTHOR.NAME"
msgid "CanisMinor"
msgstr "CanisMinor"

#. MoreRoomTypes.STRINGS.SETTINGS.BUTTON
msgctxt "MoreRoomTypes.STRINGS.SETTINGS.BUTTON"
msgid "Settings"
msgstr "设置"

#. MoreRoomTypes.STRINGS.SETTINGS.TITLE
msgctxt "MoreRoomTypes.STRINGS.SETTINGS.TITLE"
msgid "More Room Types"
msgstr "更多房间"

#. MoreRoomTypes.STRINGS.SETTINGS.HINT
msgctxt "MoreRoomTypes.STRINGS.SETTINGS.HINT"
msgid "Enable or disable each extra room type. Fully quit Oxygen Not Included after changing these, then launch again."
msgstr "可单独开关每种房间。改完后请完全退出缺氧再启动。"

#. MoreRoomTypes.STRINGS.SETTINGS.ALL_ON
msgctxt "MoreRoomTypes.STRINGS.SETTINGS.ALL_ON"
msgid "Enable all"
msgstr "全部开启"

#. MoreRoomTypes.STRINGS.SETTINGS.ALL_OFF
msgctxt "MoreRoomTypes.STRINGS.SETTINGS.ALL_OFF"
msgid "Disable all"
msgstr "全部关闭"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.GRAVEYARD.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.GRAVEYARD.NAME"
msgid "Graveyard"
msgstr "墓地"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.GRAVEYARD.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.GRAVEYARD.DESCRIPTION"
msgid "It makes Duplicants happy to think that they are still alive.\n\nVisiting a Graveyard will raise or lower Duplicants' Stress."
msgstr "让复制人感到活着真好。\n\n参观墓地会升高或降低复制人的压力。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.GRAVEYARD.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.GRAVEYARD.EFFECT"
msgid "- Stress bonus"
msgstr "- 压力加成"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.GRAVEYARD.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.GRAVEYARD.TOOLTIP"
msgid "Visiting a Graveyard will raise or lower Duplicants' Stress"
msgstr "参观墓地会升高或降低复制人的压力"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.GYMROOM.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.GYMROOM.NAME"
msgid "Gym Room"
msgstr "健身房"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.GYMROOM.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.GYMROOM.DESCRIPTION"
msgid "Professional equipment lets Duplicants exercise more efficiently.\n\nWorking a Manual Generator in a Gym Room improves Athletics training."
msgstr "专业设备让复制人更有效地锻炼。\n\n在健身房使用人力发电机会加快运动技能的提升。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.GYMROOM.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.GYMROOM.EFFECT"
msgid "- Athletics training bonus"
msgstr "- 运动训练加成"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.GYMROOM.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.GYMROOM.TOOLTIP"
msgid "Working a Manual Generator in a Gym Room improves Athletics training"
msgstr "在健身房使用人力发电机会加快运动技能的提升"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUM.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUM.NAME"
msgid "Art Museum"
msgstr "艺术博物馆"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUM.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUM.DESCRIPTION"
msgid "It used to be a storehouse, before Meep confused Pedestal content with art.\n\nVisiting an Art Museum will improve Duplicants' Morale."
msgstr "曾经不过是个仓库，直到米珀把基座上的东西认作艺术品。\n\n参观艺术博物馆会提升复制人的士气。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUM.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUM.EFFECT"
msgid "- Morale bonus"
msgstr "- 士气加成"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUM.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUM.TOOLTIP"
msgid "Visiting an Art Museum will improve Duplicants' Morale"
msgstr "参观艺术博物馆会提升复制人的士气"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUMSPACE.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUMSPACE.NAME"
msgid "Space Museum"
msgstr "太空博物馆"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUMSPACE.DESCRIPTION
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUMSPACE.DESCRIPTION"
msgid "Perfect for storing Ancient Knowledge on the pedestals.\n\nVisiting a Space Museum will improve Duplicants' Morale."
msgstr "很适合把远古知识摆上基座。\n\n参观太空博物馆会提升复制人的士气。"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUMSPACE.EFFECT
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUMSPACE.EFFECT"
msgid "- Morale bonus"
msgstr "- 士气加成"

#. MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUMSPACE.TOOLTIP
msgctxt "MoreRoomTypes.STRINGS.ROOMS.TYPES.MUSEUMSPACE.TOOLTIP"
msgid "Visiting a Space Museum will improve Duplicants' Morale"
msgstr "参观太空博物馆会提升复制人的士气"

#. MoreRoomTypes.STRINGS.ROOMS.CRITERIA.GRAVE.NAME
msgctxt "MoreRoomTypes.STRINGS.ROOMS.CRITERIA.GRAVE.NAME"
