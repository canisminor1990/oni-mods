msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.SETTINGS_BUTTON"
msgid "Settings"
msgstr "Настройки"

msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.SETTINGS_TITLE"
msgid "Custom Chinese Fonts"
msgstr "Китайские шрифты"

msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.SETTINGS_HINT"
msgid "Chinese body text uses HarmonyOS Sans SC Regular unless you add body.ttf. Restart after turning English replacement off, or after adding custom fonts."
msgstr "Основной текст использует HarmonyOS Sans SC Regular, пока не добавите body.ttf. Полностью перезапустите игру после отключения замены английских шрифтов или добавления своих."

msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.SECTION_ENGLISH"
msgid "Replace English fonts"
msgstr "Заменять английские шрифты"

msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.ENGLISH_OFF"
msgid "Off"
msgstr "Выкл."

msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.ENGLISH_ON"
msgid "On"
msgstr "Вкл."

msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.SECTION_TITLE"
msgid "Chinese title font"
msgstr "Шрифт китайских заголовков"

msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.TITLE_HARMONYOS"
msgid "HarmonyOS Sans SC Bold"
msgstr "HarmonyOS Sans SC Bold"

msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.TITLE_JINZISHE"
msgid "Jinzishe Dezheng"
msgstr "Jinzishe Dezheng"

msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.TITLE_CUSTOM"
msgid "Custom"
msgstr "Свой"

msgctxt "CustomChineseFonts.STRINGS.CUSTOM_CHINESE_FONTS.CUSTOM_FONTS_HINT"
msgid "Optional own fonts: put body.ttf / title.ttf (or .otf) in Documents/Klei/OxygenNotIncluded/mods/config/CustomChineseFonts/custom_fonts/ then fully restart."
msgstr "Свои шрифты: положите body.ttf / title.ttf (или .otf) в Documents/Klei/OxygenNotIncluded/mods/config/CustomChineseFonts/custom_fonts/ и полностью перезапустите игру."

